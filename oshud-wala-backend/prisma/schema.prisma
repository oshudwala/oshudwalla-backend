// =====================================================================
// OSHUD WALA - PRISMA SCHEMA (Phase 3 design v3: Clean Pharmacy Architecture)
// Conventions:
//  - Money is integer PAISE (Int for order/item amounts, BigInt for wallet/ledger).
//  - UUID primary keys. Tables are snake_case via @@map.
//  - Actor columns in history/audit tables (actorId, reviewedById, ...) are plain
//    UUIDs on purpose: those rows must outlive user changes and need no back-relation.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------- ENUMS -------------------------------

enum RoleName {
  SUPER_ADMIN
  PATIENT
  PHARMACY
  DOCTOR
  RECEPTIONIST
  RIDER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EntityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SlotStatus {
  OPEN
  BLOCKED
}

enum QueueStatus {
  OPEN
  PAUSED
  CLOSED
}

enum ScheduleExceptionType {
  LEAVE
  MODIFIED_HOURS
}

enum PrescriptionStatus {
  SUBMITTED
  CLINIC_REVIEW
  FORWARDED_TO_PHARMACY
  PHARMACY_VERIFYING
  AWAITING_CUSTOMER_CONFIRMATION
  VERIFIED
  REJECTED
  CANCELLED
  EXPIRED
}

enum PrescriptionItemStatus {
  PENDING
  AVAILABLE
  SUBSTITUTED
  UNAVAILABLE
}

enum OrderStatus {
  PENDING_PHARMACY_REVIEW
  AWAITING_CUSTOMER_CONFIRMATION
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  SHIPPED
  DELIVERED
  DELIVERY_FAILED
  RETURNED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  COLLECTED
  SETTLED
  REFUNDED
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  FAILED
  CANCELLED
}

enum RiderStatus {
  OFFLINE
  AVAILABLE
  BUSY
  SUSPENDED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QrStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum OtpStatus {
  ACTIVE
  VERIFIED
  EXPIRED
  LOCKED
  SUPERSEDED
}

enum WalletOwnerType {
  CUSTOMER
  PHARMACY
  RIDER
  PLATFORM
}

enum LedgerTxType {
  RIDER_EARNING
  COD_COLLECTED
  COD_DEPOSIT_VERIFIED
  WITHDRAWAL_HOLD
  WITHDRAWAL_RELEASE
  WITHDRAWAL_PAYOUT
  COMMISSION
  PHARMACY_SETTLEMENT_CREDIT
  REFUND
  ADJUSTMENT
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  HOLD_CAPTURE
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum SettlementType {
  WITHDRAWAL_PAYOUT
  COD_CASH_DEPOSIT
}

enum CashCollectionStatus {
  COLLECTED
  DEPOSIT_PENDING
  DEPOSITED
  VERIFIED
  DISCREPANCY
}

enum CashDepositStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum CouponDiscountType {
  PERCENT
  FLAT
}

enum CoinTxType {
  REFERRAL_REWARD
  REDEEMED
  REFUNDED
  EXPIRED
  ADJUSTMENT
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  VOID
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
  CANCELLED
}

enum CommissionTarget {
  PHARMACY_ORDER
  APPOINTMENT
}

enum PharmacyStaffRole {
  OWNER
  RECEPTIONIST
}

enum NotificationCategory {
  ORDER
  DELIVERY
  PRESCRIPTION
  APPOINTMENT
  QUEUE
  PAYMENT
  WALLET
  REFERRAL
  SUPPORT
  SECURITY
  PHARMACY
  SYSTEM
}

enum NotificationPriority {
  NORMAL
  HIGH
}

enum NotificationChannel {
  PUSH
  SOCKET
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
  INVALID_TOKEN
}

enum PushProvider {
  FCM
}

// ------------------------- AUTH, RBAC, SESSIONS -----------------------

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  roleId           String     @db.Uuid
  role             Role       @relation(fields: [roleId], references: [id])
  email            String?    @unique
  phone            String     @unique
  passwordHash     String
  fullName         String
  status           UserStatus @default(ACTIVE)
  phoneVerifiedAt  DateTime?
  emailVerifiedAt  DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  referralCode     String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  sessions                Session[]
  passwordResets          PasswordResetToken[]
  patientProfile          PatientProfile?
  doctor                  Doctor?
  riderProfile            RiderProfile?
  addresses               Address[]
  pharmacyStaff           PharmacyStaff[]
  notificationPreferences NotificationPreference[]
  notificationSetting     NotificationSetting?
  cart                    Cart?
  orders                  Order[]                  @relation("PatientOrders")
  prescriptions           Prescription[]           @relation("PatientPrescriptions")
  appointments            Appointment[]            @relation("PatientAppointments")
  notifications           Notification[]
  deviceTokens            DeviceToken[]
  wallets                 Wallet[]
  coinAccount             CoinAccount?
  referralsMade           Referral[]               @relation("Referrer")
  referralReceived        Referral?                @relation("Referred")
  couponRedemptions       CouponRedemption[]
  supportTickets          SupportTicket[]          @relation("TicketOwner")
  assignedTickets         SupportTicket[]          @relation("TicketAssignee")
  supportMessages         SupportMessage[]
  ridersDeliveries        Delivery[]               @relation("RiderDeliveries")
  cashCollections         CashCollection[]
  cashDeposits            CashDeposit[]
  auditLogs               AuditLog[]

  @@index([roleId])
  @@index([status])
  reviews Review[]
  receptionistDoctors ReceptionistDoctor[]
  @@map("users")
}

model Session {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName    String?
  userAgent     String?
  ipAddress     String?
  lastUsedAt    DateTime       @default(now())
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @db.Uuid
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  key          String
  route        String
  requestHash  String
  responseCode Int?
  responseBody Json?
  lockedAt     DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([userId, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorId    String?   @db.Uuid
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  RoleName?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  type          String
  aggregateType String?
  aggregateId   String?
  dedupeKey     String?      @unique
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, status])
  @@map("outbox_events")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// --------------------------- PATIENT & ADDRESS ------------------------

model PatientProfile {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth  DateTime? @db.Date
  gender       Gender?
  bloodGroup   String?
  allergies    String?
  medicalNotes String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("patient_profiles")
}

model Address {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  latitude  Decimal?  @db.Decimal(9, 6)
  longitude Decimal?  @db.Decimal(9, 6)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  orders    Order[]

  @@index([userId])
  @@map("addresses")
}

// ------------------------- PHARMACY (The Core Business Entity) -----------

model Pharmacy {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  nameBn        String?
  nameHi        String?
  legalName     String?
  businessRegNo String?      @unique
  licenseNumber String?
  phone         String
  email         String?
  website       String?
  logoUrl       String?
  coverUrl      String?
  galleryUrls   String[]     @default([])
  hasClinicService   Boolean      @default(false)
  hasMedicineService Boolean      @default(true)
  line1         String
  line2         String?
  landmark      String?
  city          String
  state         String
  pincode       String
  latitude      Decimal?     @db.Decimal(9, 6)
  longitude     Decimal?     @db.Decimal(9, 6)
  timezone      String       @default("Asia/Kolkata")
  openingHours  Json?
  settings      Json         @default("{}")
  status        EntityStatus @default(ACTIVE)
  isPrimary     Boolean      @default(false) // Super Admin controls this
  locationId    String?      @db.Uuid

  registeredById String?   @db.Uuid
  approvedById   String?   @db.Uuid
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  staff           PharmacyStaff[]
  doctors         PharmacyDoctor[]
  orders          Order[]
  prescriptions   Prescription[]
  pickupQrs       PickupQr[]
  wallet          Wallet?
  commissionRules CommissionRule[]
  hours           PharmacyOpeningHour[]
  holidays        PharmacyHoliday[]
  location        Location?    @relation(fields: [locationId], references: [id])

  @@index([city, status])
  @@index([status])
  @@index([locationId])
  reviews Review[]
  isFeatured    Boolean @default(false)
  featuredOrder Int     @default(0)

  @@index([isFeatured, featuredOrder])
  @@map("pharmacies")
}

model PharmacyStaff {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyId String            @db.Uuid
  pharmacy   Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  staffRole  PharmacyStaffRole
  licenseNo  String?
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())

  @@unique([userId, pharmacyId])
  @@index([pharmacyId, staffRole, isActive])
  @@map("pharmacy_staff")
}

// ----------------------------- LOCATIONS ----------------------------
// Official location master. Managed by SUPER_ADMIN only.

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  city      String
  area      String?
  state     String
  pincode   String
  country   String   @default("India")
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isActive  Boolean  @default(true)
  // lower(city)|lower(area)|pincode  -> prevents duplicates even when area is null
  uniqueKey String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pharmacies Pharmacy[]

  @@index([state, city, isActive])
  @@index([isActive])
  @@map("locations")
}

// ----------------------------- DOCTORS ------------------------------

model Specialization {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String                 @unique
  description String?
  isActive    Boolean                @default(true)
  doctors     DoctorSpecialization[]

  @@map("specializations")
}

// Decoupled Doctor model: Can exist with OR without a User account
model Doctor {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String?  @unique @db.Uuid // Null if unregistered
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName           String
  phone              String?  @unique // Used to link to user account later
  email              String?  @unique // Used to link to user account later
  registrationNumber String?  @unique
  qualifications     String?
  experienceYears    Int?
  bio                String?
  languages          String[]
  isVerified         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  specializations DoctorSpecialization[]
  pharmacies      PharmacyDoctor[]
  notifications   Notification[]         @relation("DoctorNotifications") // Pending notifications wait here
  reviews Review[]
  isFeatured    Boolean @default(false)
  featuredOrder Int     @default(0)

  @@index([isFeatured, featuredOrder])

  @@map("doctors")
}

model DoctorSpecialization {
  doctorId         String         @db.Uuid
  specializationId String         @db.Uuid
  doctor           Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([doctorId, specializationId])
  @@map("doctor_specializations")
}

// Maps a Doctor to a Pharmacy (Super Admin assigns them here)
model PharmacyDoctor {
  id                   String   @id @default(uuid()) @db.Uuid
  pharmacyId           String   @db.Uuid
  pharmacy             Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  doctorId             String   @db.Uuid
  doctor               Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultationFeePaise Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  schedules    DoctorSchedule[]
  exceptions   ScheduleException[]
  slots        AppointmentSlot[]
  appointments Appointment[]
  queueDays    QueueDay[]

  @@unique([pharmacyId, doctorId])
  @@index([pharmacyId, isActive])
  receptionists ReceptionistDoctor[]
  @@map("pharmacy_doctors")
}

// ------------------------- SCHEDULE, SLOTS, APPOINTMENTS ---------------

model DoctorSchedule {
  id                  String         @id @default(uuid()) @db.Uuid
  pharmacyDoctorId    String         @db.Uuid
  pharmacyDoctor      PharmacyDoctor @relation(fields: [pharmacyDoctorId], references: [id], onDelete: Cascade)
  recurrenceType      String    @default("WEEKLY")
  weekOfMonth         Int?
  specificDate        DateTime? @db.Date
  dayOfWeek           Int
  startMinute         Int
  endMinute           Int
  slotDurationMinutes Int
  slotCapacity        Int            @default(1)
  validFrom           DateTime       @db.Date
  validTo             DateTime?      @db.Date
  isActive            Boolean        @default(true)

  @@index([pharmacyDoctorId, dayOfWeek, isActive])
  @@map("doctor_schedules")
}

model ScheduleException {
  id               String                @id @default(uuid()) @db.Uuid
  pharmacyDoctorId String                @db.Uuid
  pharmacyDoctor   PharmacyDoctor        @relation(fields: [pharmacyDoctorId], references: [id], onDelete: Cascade)
  exceptionDate    DateTime              @db.Date
  type             ScheduleExceptionType
  startMinute      Int?
  endMinute        Int?
  reason           String?

  @@unique([pharmacyDoctorId, exceptionDate])
  @@map("schedule_exceptions")
}

model AppointmentSlot {
  id               String         @id @default(uuid()) @db.Uuid
  pharmacyDoctorId String         @db.Uuid
  pharmacyDoctor   PharmacyDoctor @relation(fields: [pharmacyDoctorId], references: [id], onDelete: Cascade)
  slotDate         DateTime       @db.Date
  startMinute      Int
  endMinute        Int
  capacity         Int
  bookedCount      Int            @default(0)
  status           SlotStatus     @default(OPEN)
  appointments     Appointment[]

  @@unique([pharmacyDoctorId, slotDate, startMinute])
  @@index([pharmacyDoctorId, slotDate, status])
  @@map("appointment_slots")
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  appointmentNumber String            @unique
  patientId         String            @db.Uuid
  patient           User              @relation("PatientAppointments", fields: [patientId], references: [id])
  pharmacyDoctorId  String            @db.Uuid
  pharmacyDoctor    PharmacyDoctor    @relation(fields: [pharmacyDoctorId], references: [id])
  slotId            String            @db.Uuid
  slot              AppointmentSlot   @relation(fields: [slotId], references: [id])
  appointmentDate   DateTime          @db.Date
  tokenNumber       Int
  status            AppointmentStatus @default(BOOKED)
  feePaise          Int
  reason            String?
  doctorNotes       String?
  idempotencyKey    String?
  bookedAt          DateTime          @default(now())
  checkedInAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?

  @@unique([pharmacyDoctorId, appointmentDate, tokenNumber])
  @@unique([patientId, idempotencyKey])
  @@index([patientId, status])
  @@index([slotId])
  @@index([pharmacyDoctorId, appointmentDate, status])
  @@map("appointments")
}

model QueueDay {
  id                 String         @id @default(uuid()) @db.Uuid
  pharmacyDoctorId   String         @db.Uuid
  pharmacyDoctor     PharmacyDoctor @relation(fields: [pharmacyDoctorId], references: [id], onDelete: Cascade)
  queueDate          DateTime       @db.Date
  lastTokenIssued    Int            @default(0)
  currentTokenNumber Int?
  status             QueueStatus    @default(OPEN)
  updatedAt          DateTime       @updatedAt

  @@unique([pharmacyDoctorId, queueDate])
  @@map("queue_days")
}

// ---------------------------- CATALOG ------------------------

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  slug      String     @unique
  parentId  String?    @db.Uuid
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  imageUrl  String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  products  Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String   @unique
  genericName          String?
  manufacturer         String?
  categoryId           String   @db.Uuid
  category             Category @relation(fields: [categoryId], references: [id])
  description          String?
  packSize             String?
  mrpPaise             Int
  requiresPrescription Boolean  @default(false)
  imageUrls            String[]
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  cartItems         CartItem[]
  orderItems        OrderItem[]
  prescriptionItems PrescriptionItem[] @relation("PrescriptionItemProduct")
  substituteItems   PrescriptionItem[] @relation("PrescriptionItemSubstitute")

  @@index([categoryId, isActive])
  @@index([name])
  @@index([genericName])
  @@map("products")
}

// ------------------------------ PRESCRIPTIONS ------------------------

model Prescription {
  id                 String @id @default(uuid()) @db.Uuid
  prescriptionNumber String @unique
  patientId          String @db.Uuid
  patient            User   @relation("PatientPrescriptions", fields: [patientId], references: [id])

  pharmacyId String?   @db.Uuid // Primary Pharmacy or User Selected Pharmacy
  pharmacy   Pharmacy? @relation(fields: [pharmacyId], references: [id])

  status          PrescriptionStatus @default(SUBMITTED)
  doctorName      String?
  patientNote     String?
  rejectionReason String?
  verifiedById    String?            @db.Uuid
  verifiedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  files   PrescriptionFile[]
  items   PrescriptionItem[]
  history PrescriptionStatusHistory[]
  orders  Order[]

  @@index([patientId, status])
  @@index([pharmacyId, status])
  @@map("prescriptions")
}

model PrescriptionFile {
  id             String       @id @default(uuid()) @db.Uuid
  prescriptionId String       @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  storageKey     String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  uploadedAt     DateTime     @default(now())

  @@index([prescriptionId])
  @@map("prescription_files")
}

model PrescriptionItem {
  id             String                 @id @default(uuid()) @db.Uuid
  prescriptionId String                 @db.Uuid
  prescription   Prescription           @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  nameAsWritten  String
  productId      String?                @db.Uuid
  product        Product?               @relation("PrescriptionItemProduct", fields: [productId], references: [id])
  substituteId   String?                @db.Uuid
  substitute     Product?               @relation("PrescriptionItemSubstitute", fields: [substituteId], references: [id])
  quantity       Int
  dosage         String?
  status         PrescriptionItemStatus @default(PENDING)
  reviewNote     String?  @map("pharmacistNote")

  @@index([prescriptionId])
  @@map("prescription_items")
}

model PrescriptionStatusHistory {
  id             String              @id @default(uuid()) @db.Uuid
  prescriptionId String              @db.Uuid
  prescription   Prescription        @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  fromStatus     PrescriptionStatus?
  toStatus       PrescriptionStatus
  actorId        String?             @db.Uuid
  reason         String?
  createdAt      DateTime            @default(now())

  @@index([prescriptionId, createdAt])
  @@map("prescription_status_history")
}

// ------------------------------- CART --------------------------------

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  addedAt   DateTime @default(now())

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ------------------------------- ORDERS ------------------------------

model Order {
  id                  String        @id @default(uuid()) @db.Uuid
  orderNumber         String        @unique
  patientId           String        @db.Uuid
  patient             User          @relation("PatientOrders", fields: [patientId], references: [id])
  pharmacyId          String        @db.Uuid
  pharmacy            Pharmacy      @relation(fields: [pharmacyId], references: [id])
  prescriptionId      String?       @db.Uuid
  prescription        Prescription? @relation(fields: [prescriptionId], references: [id])
  addressId           String?       @db.Uuid
  address             Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)
  deliveryAddress     Json
  status              OrderStatus   @default(PENDING_PHARMACY_REVIEW)
  paymentMethod       PaymentMethod @default(COD)
  paymentStatus       PaymentStatus @default(PENDING)
  subtotalPaise       Int
  couponDiscountPaise Int           @default(0)
  coinDiscountPaise   Int           @default(0)
  deliveryFeePaise    Int           @default(0)
  totalPaise          Int
  couponId            String?       @db.Uuid
  coinsUsed           Int           @default(0)
  idempotencyKey      String?
  cancelReason        String?
  placedAt            DateTime      @default(now())
  acceptedAt          DateTime?
  readyAt             DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  updatedAt           DateTime      @updatedAt

  items            OrderItem[]
  history          OrderStatusHistory[]
  delivery         Delivery?
  couponRedemption CouponRedemption?
  cashCollection   CashCollection?
  deliveryOtps     DeliveryOtp[]
  coupon           Coupon?              @relation(fields: [couponId], references: [id])

  @@unique([patientId, idempotencyKey])
  @@index([patientId, status, placedAt])
  @@index([pharmacyId, status, placedAt])
  @@index([status, placedAt])
  @@map("orders")
}

model OrderItem {
  id                   String  @id @default(uuid()) @db.Uuid
  orderId              String  @db.Uuid
  order                Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String  @db.Uuid
  product              Product @relation(fields: [productId], references: [id])
  nameSnapshot         String
  quantity             Int
  mrpPaise             Int
  unitPricePaise       Int
  lineTotalPaise       Int
  requiresPrescription Boolean @default(false)
  prescriptionVerified Boolean @default(false)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?      @db.Uuid
  actorRole  RoleName?
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ------------------------- RIDERS & DELIVERY -------------------------

model RiderProfile {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @unique @db.Uuid
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType    String?
  vehicleNumber  String?
  licenseNumber  String?
  kycStatus      KycStatus   @default(PENDING)
  status         RiderStatus @default(OFFLINE)
  currentLat     Decimal?    @db.Decimal(9, 6)
  currentLng     Decimal?    @db.Decimal(9, 6)
  lastLocationAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@map("rider_profiles")
}

model DeliveryBatch {
  id           String     @id @default(uuid()) @db.Uuid
  riderId      String     @db.Uuid
  assignedById String     @db.Uuid
  createdAt    DateTime   @default(now())
  deliveries   Delivery[]
  pickupQrs    PickupQr[]

  @@index([riderId, createdAt])
  @@map("delivery_batches")
}

model Delivery {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @unique @db.Uuid
  order             Order          @relation(fields: [orderId], references: [id])
  batchId           String         @db.Uuid
  batch             DeliveryBatch  @relation(fields: [batchId], references: [id])
  riderId           String         @db.Uuid
  rider             User           @relation("RiderDeliveries", fields: [riderId], references: [id])
  assignedById      String         @db.Uuid
  status            DeliveryStatus @default(ASSIGNED)
  assignedAt        DateTime       @default(now())
  acceptedAt        DateTime?
  pickedUpAt        DateTime?
  shippedAt         DateTime?
  arrivedAt         DateTime?
  deliveredAt       DateTime?
  failedReason      String?
  riderEarningPaise Int?

  otps    DeliveryOtp[]
  history DeliveryStatusHistory[]

  @@index([riderId, status])
  @@index([batchId])
  @@map("deliveries")
}

model DeliveryStatusHistory {
  id         String          @id @default(uuid()) @db.Uuid
  deliveryId String          @db.Uuid
  delivery   Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus
  riderId    String?         @db.Uuid
  actorId    String?         @db.Uuid
  note       String?
  createdAt  DateTime        @default(now())

  @@index([deliveryId, createdAt])
  @@map("delivery_status_history")
}

model PickupQr {
  id            String        @id @default(uuid()) @db.Uuid
  batchId       String        @db.Uuid
  batch         DeliveryBatch @relation(fields: [batchId], references: [id])
  pharmacyId    String        @db.Uuid
  pharmacy      Pharmacy      @relation(fields: [pharmacyId], references: [id])
  tokenHash     String        @unique
  status        QrStatus      @default(ACTIVE)
  expiresAt     DateTime
  usedAt        DateTime?
  usedByRiderId String?       @db.Uuid
  createdAt     DateTime      @default(now())

  @@unique([batchId, pharmacyId])
  @@index([status, expiresAt])
  @@map("pickup_qrs")
}

model DeliveryOtp {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @db.Uuid
  order         Order     @relation(fields: [orderId], references: [id])
  deliveryId    String    @db.Uuid
  delivery      Delivery  @relation(fields: [deliveryId], references: [id])
  customerId    String    @db.Uuid
  riderId       String    @db.Uuid
  otpHash       String
  otpCiphertext String
  status        OtpStatus @default(ACTIVE)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([deliveryId, status])
  @@index([orderId])
  @@map("delivery_otps")
}

// ------------------------- COD CASH COLLECTION -----------------------

model CashCollection {
  id          String               @id @default(uuid()) @db.Uuid
  orderId     String               @unique @db.Uuid
  order       Order                @relation(fields: [orderId], references: [id])
  riderId     String               @db.Uuid
  rider       User                 @relation(fields: [riderId], references: [id])
  amountPaise Int
  status      CashCollectionStatus @default(COLLECTED)
  collectedAt DateTime             @default(now())
  depositId   String?              @db.Uuid
  deposit     CashDeposit?         @relation(fields: [depositId], references: [id])
  verifiedAt  DateTime?

  @@index([riderId, status])
  @@index([depositId])
  @@map("cash_collections")
}

model CashDeposit {
  id              String            @id @default(uuid()) @db.Uuid
  riderId         String            @db.Uuid
  rider           User              @relation(fields: [riderId], references: [id])
  amountPaise     Int
  method          String
  referenceNo     String?
  status          CashDepositStatus @default(SUBMITTED)
  verifiedById    String?           @db.Uuid
  verifiedAt      DateTime?
  rejectionReason String?
  submittedAt     DateTime          @default(now())
  collections     CashCollection[]
  settlement      Settlement?

  @@index([riderId, status])
  @@map("cash_deposits")
}

// -------------------------------- WALLET -----------------------------

model Wallet {
  id            String          @id @default(uuid()) @db.Uuid
  ownerKey      String          @unique
  ownerType     WalletOwnerType
  userId        String?         @db.Uuid
  user          User?           @relation(fields: [userId], references: [id])
  pharmacyId    String?         @unique @db.Uuid
  pharmacy      Pharmacy?       @relation(fields: [pharmacyId], references: [id])
  balancePaise  BigInt          @default(0)
  heldPaise     BigInt          @default(0)
  allowNegative Boolean         @default(false)
  version       Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  entries     LedgerEntry[]
  withdrawals WithdrawalRequest[]

  @@index([ownerType, userId])
  @@map("wallets")
}

model LedgerTransaction {
  id             String        @id @default(uuid()) @db.Uuid
  txType         LedgerTxType
  referenceType  String
  referenceId    String
  idempotencyKey String        @unique
  description    String?
  createdBy      String?       @db.Uuid
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]

  @@unique([txType, referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                String            @id @default(uuid()) @db.Uuid
  transactionId     String            @db.Uuid
  transaction       LedgerTransaction @relation(fields: [transactionId], references: [id])
  walletId          String            @db.Uuid
  wallet            Wallet            @relation(fields: [walletId], references: [id])
  entryType         LedgerEntryType
  amountPaise       BigInt
  balanceAfterPaise BigInt
  heldAfterPaise    BigInt
  createdAt         DateTime          @default(now())

  @@index([walletId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model WithdrawalRequest {
  id              String           @id @default(uuid()) @db.Uuid
  walletId        String           @db.Uuid
  wallet          Wallet           @relation(fields: [walletId], references: [id])
  requestedById   String           @db.Uuid
  amountPaise     BigInt
  status          WithdrawalStatus @default(REQUESTED)
  payoutDetails   Json
  idempotencyKey  String?
  reviewedById    String?          @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?
  requestedAt     DateTime         @default(now())
  settlement      Settlement?

  @@unique([requestedById, idempotencyKey])
  @@index([walletId, status])
  @@index([status, requestedAt])
  @@map("withdrawal_requests")
}

model Settlement {
  id                  String             @id @default(uuid()) @db.Uuid
  type                SettlementType
  amountPaise         BigInt
  method              String
  referenceNo         String?
  withdrawalRequestId String?            @unique @db.Uuid
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])
  cashDepositId       String?            @unique @db.Uuid
  cashDeposit         CashDeposit?       @relation(fields: [cashDepositId], references: [id])
  settledById         String             @db.Uuid
  settledAt           DateTime           @default(now())
  ledgerTransactionId String?            @unique @db.Uuid

  @@index([type, settledAt])
  @@map("settlements")
}

model CommissionRule {
  id         String           @id @default(uuid()) @db.Uuid
  target     CommissionTarget
  pharmacyId String?          @db.Uuid
  pharmacy   Pharmacy?        @relation(fields: [pharmacyId], references: [id])
  rateBps    Int
  isActive   Boolean          @default(true)
  validFrom  DateTime         @default(now())
  validTo    DateTime?

  @@index([target, isActive])
  @@map("commission_rules")
}

// --------------------------- REFERRAL, COINS, COUPONS ----------------

model Referral {
  id                String         @id @default(uuid()) @db.Uuid
  referrerId        String         @db.Uuid
  referrer          User           @relation("Referrer", fields: [referrerId], references: [id])
  referredUserId    String         @unique @db.Uuid
  referredUser      User           @relation("Referred", fields: [referredUserId], references: [id])
  status            ReferralStatus @default(PENDING)
  qualifyingOrderId String?        @unique @db.Uuid
  rewardCoins       Int?
  rewardedAt        DateTime?
  createdAt         DateTime       @default(now())

  @@index([referrerId, status])
  @@map("referrals")
}

model CoinAccount {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @unique @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int               @default(0)
  updatedAt DateTime          @updatedAt
  entries   CoinTransaction[]

  @@map("coin_accounts")
}

model CoinTransaction {
  id            String      @id @default(uuid()) @db.Uuid
  accountId     String      @db.Uuid
  account       CoinAccount @relation(fields: [accountId], references: [id])
  type          CoinTxType
  amount        Int
  balanceAfter  Int
  referenceType String
  referenceId   String
  createdAt     DateTime    @default(now())

  @@unique([accountId, type, referenceType, referenceId])
  @@index([accountId, createdAt])
  @@map("coin_transactions")
}

model Coupon {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique
  description       String?
  discountType      CouponDiscountType
  discountValue     Int
  maxDiscountPaise  Int?
  minOrderPaise     Int                @default(0)
  validFrom         DateTime
  validTo           DateTime
  usageLimitTotal   Int?
  usageLimitPerUser Int?
  usedCount         Int                @default(0)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([isActive, validTo])
  @@map("coupons")
}

model CouponRedemption {
  id            String   @id @default(uuid()) @db.Uuid
  couponId      String   @db.Uuid
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id])
  orderId       String   @unique @db.Uuid
  order         Order    @relation(fields: [orderId], references: [id])
  discountPaise Int
  redeemedAt    DateTime @default(now())

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ----------------------- NOTIFICATIONS & SUPPORT ---------------------

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String?              @db.Uuid // Made optional to support pending Doctor notifications
  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId    String?              @db.Uuid // Doctor target (registered or unregistered)
  doctor      Doctor?              @relation("DoctorNotifications", fields: [doctorId], references: [id], onDelete: Cascade)
  category    NotificationCategory
  eventType   String
  title       String
  body        String
  data        Json?
  priority    NotificationPriority @default(NORMAL)
  isSensitive Boolean              @default(false)
  isMandatory Boolean              @default(false)
  entityType  String?
  entityId    String?
  dedupeKey   String
  readAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())

  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([doctorId, readAt]) // Added index for Doctor notifications
  @@index([entityType, entityId])
  @@map("notifications")
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String                     @db.Uuid
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  deviceTokenId     String?                    @db.Uuid
  deviceToken       DeviceToken?               @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)
  provider          PushProvider?
  status            NotificationDeliveryStatus @default(PENDING)
  skipReason        String?
  providerMessageId String?
  attempts          Int                        @default(0)
  lastErrorCode     String?
  lastErrorMessage  String?
  nextRetryAt       DateTime?
  queuedAt          DateTime                   @default(now())
  sentAt            DateTime?
  ackedAt           DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([notificationId, channel, deviceTokenId])
  @@index([status, createdAt])
  @@index([notificationId])
  @@index([deviceTokenId])
  @@map("notification_deliveries")
}

model DeviceToken {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String?        @db.Uuid
  session       Session?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  deviceId      String
  token         String         @unique
  platform      DevicePlatform
  provider      PushProvider   @default(FCM)
  appVersion    String?
  osVersion     String?
  deviceModel   String?
  locale        String?
  isActive      Boolean        @default(true)
  invalidatedAt DateTime?
  invalidReason String?
  lastSeenAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  deliveries NotificationDelivery[]

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@index([isActive, lastSeenAt])
  @@map("device_tokens")
}

model NotificationPreference {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  pushEnabled  Boolean              @default(true)
  inAppEnabled Boolean              @default(true)
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
  @@map("notification_preferences")
}

model NotificationSetting {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled      Boolean  @default(true)
  quietStartMinute Int?
  quietEndMinute   Int?
  timezone         String   @default("Asia/Kolkata")
  updatedAt        DateTime @updatedAt

  @@map("notification_settings")
}

model SupportTicket {
  id           String           @id @default(uuid()) @db.Uuid
  ticketNumber String           @unique
  userId       String           @db.Uuid
  user         User             @relation("TicketOwner", fields: [userId], references: [id])
  orderId      String?          @db.Uuid
  subject      String
  status       TicketStatus     @default(OPEN)
  priority     TicketPriority   @default(NORMAL)
  assigneeId   String?          @db.Uuid
  assignee     User?            @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     SupportMessage[]

  @@index([userId, status])
  @@index([status, priority])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String        @db.Uuid
  sender    User          @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model PharmacyOpeningHour {
  id          String   @id @default(uuid()) @db.Uuid
  pharmacyId  String   @db.Uuid
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0 = Sunday ... 6 = Saturday
  openMinute  Int?     // 0..1439 (null when isClosed = true)
  closeMinute Int?     // 1..1440 (null when isClosed = true)
  isClosed    Boolean  @default(false)

  @@unique([pharmacyId, dayOfWeek])
  @@index([pharmacyId])
  @@map("pharmacy_opening_hours")
}

model PharmacyHoliday {
  id          String   @id @default(uuid()) @db.Uuid
  pharmacyId  String   @db.Uuid
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  holidayDate DateTime @db.Date
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([pharmacyId, holidayDate])
  @@index([pharmacyId, holidayDate])
  @@map("pharmacy_holidays")
}

model Promotion {
  id          String    @id @default(uuid()) @db.Uuid
  heading     String
  paragraph   String?
  imageUrl    String
  buttonText  String?
  buttonLink  String?
  couponCode  String?
  placement   String    @default("HOME_TOP")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  validFrom   DateTime?
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, placement, sortOrder])
  @@map("promotions")
}


model Review {
  id         String    @id @default(uuid()) @db.Uuid
  patientId  String    @db.Uuid
  patient    User      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  targetType String    // "PHARMACY" | "DOCTOR"
  pharmacyId String?   @db.Uuid
  pharmacy   Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  doctorId   String?   @db.Uuid
  doctor     Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rating     Int       // 1 to 5
  comment    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([patientId, pharmacyId])
  @@unique([patientId, doctorId])
  @@index([pharmacyId])
  @@index([doctorId])
  @@map("reviews")
}


model ReceptionistDoctor {
  id                 String         @id @default(uuid()) @db.Uuid
  receptionistUserId String         @db.Uuid
  receptionist       User           @relation(fields: [receptionistUserId], references: [id], onDelete: Cascade)
  pharmacyDoctorId   String         @db.Uuid
  pharmacyDoctor     PharmacyDoctor @relation(fields: [pharmacyDoctorId], references: [id], onDelete: Cascade)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())

  @@unique([receptionistUserId, pharmacyDoctorId])
  @@index([receptionistUserId, isActive])
  @@index([pharmacyDoctorId, isActive])
  @@map("receptionist_doctors")
}


model AppointmentBookingRule {
  id                           String   @id @default("default")
  maxAdvanceBookingDays        Int      @default(3)
  minAdvanceBookingCutoffHours Int      @default(2)
  cancellationDeadlineHours    Int      @default(4)
  refundPercentBeforeDeadline  Int      @default(100)
  refundPercentAfterDeadline   Int      @default(0)
  allowPatientSelfCancel       Boolean  @default(true)
  maxOnlineTokensPerHour       Int      @default(8)
  walkInReservationPercent     Int      @default(20)
  notifyPatientTokensAhead     Int      @default(3)
  platformConvenienceFeeRupees Int      @default(0)
  permittedPaymentMode         String   @default("BOTH") // "ONLINE_ONLY" | "CLINIC_ONLY" | "BOTH"
  updatedById                  String?  @db.Uuid
  updatedAt                    DateTime @updatedAt

  @@map("appointment_booking_rules")
}
