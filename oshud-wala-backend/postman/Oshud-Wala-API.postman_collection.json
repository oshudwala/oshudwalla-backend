{
    "info": {
        "name": "Oshud Wala API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth Module",
            "item": [
                {
                    "name": "Register",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": ["Content-Type: application/json"],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"fullName\": \"Test Postman\",\n    \"phone\": \"8888888888\",\n    \"password\": \"Password123\"\n}"
                        },
                        "url": {"raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"]}
                    }
                },
                {
                    "name": "Login (Auto-set Tokens)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "var jsonData = pm.response.json();",
                                    "if(jsonData.success) {",
                                    "    pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
                                    "    pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
                                    "    pm.environment.set(\"sessionId\", jsonData.data.sessionId);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": ["Content-Type: application/json"],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"identifier\": \"8888888888\",\n    \"password\": \"Password123\"\n}"
                        },
                        "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"]}
                    }
                }
            ]
        }
    ],
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:6000" }
    ]
}