            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "locations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"city\": \"Kolkata\",\n  \"state\": \"West Bengal\",\n  \"pincode\": \"12\"\n}"
        }
      }
    },
    {
      "name": "6. Lat without Lng -> 400",
      "request": {
        "method": "POST",
        "header": [
          {
