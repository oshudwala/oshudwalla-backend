{
  "info": {
    "name": "Oshud Wala - Step 2 Location",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminPhone",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "patientPhone",
      "value": ""
    },
    {
      "key": "patientPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Login Super Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{adminPhone}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=pm.response.json();",
              "pm.environment.set('adminToken', j.data.accessToken);",
              "pm.test('login 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "0b. Login Patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{patientPhone}}\",\n  \"password\": \"{{patientPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('patientToken', pm.response.json().data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Create location (Super Admin) -> 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "locations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"city\": \"Durgapur\",\n  \"area\": \"City Centre\",\n  \"state\": \"West Bengal\",\n  \"pincode\": \"713216\",\n  \"latitude\": 23.5204,\n  \"longitude\": 87.3119\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=pm.response.json();",
              "if(j.data&&j.data.id) pm.environment.set('locationId', j.data.id);",
              "pm.test('201',()=>pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create duplicate -> 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "locations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"city\": \"durgapur\",\n  \"area\": \"city centre\",\n  \"state\": \"West Bengal\",\n  \"pincode\": \"713216\"\n}"
        }
      }
    },
    {
      "name": "3. Patient create -> 403",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patientToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
