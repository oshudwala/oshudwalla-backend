            "locations",
            "{{locationId}}",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isActive\": false\n}"
        }
      }
    },
    {
      "name": "10. Public get inactive -> 404",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
