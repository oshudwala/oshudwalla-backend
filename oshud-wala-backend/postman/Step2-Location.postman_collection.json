          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"area\": \"Bidhannagar\"\n}"
        }
      }
    },
    {
      "name": "8. Public list (no token) -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations?city=Durgapur",
