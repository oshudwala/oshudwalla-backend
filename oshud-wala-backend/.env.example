PORT=5000
NODE_ENV=development

# Supabase PostgreSQL (use your own values in .env, never commit .env)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth secrets: generate with  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME_TOO"

# Redis
REDIS_URL="redis://localhost:6379"

# Initial Super Admin (used only by: npm run db:seed)
SUPER_ADMIN_FULL_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PHONE="9000000000"
SUPER_ADMIN_PASSWORD="CHANGE_ME_MIN_12_CHARS"
